@startuml Microservices Architecture
!theme plain

package "Microservices Mono-Repo" {
  [config-server] as ConfigServer
  [discovery-service] as DiscoveryService
  [gateway-service] as GatewayService
  [auth-service] as AuthService
  [account-service] as AccountService
  [business-service] as BusinessService
  [keycloak] as Keycloak
}

database "PostgreSQL" as Postgres {
  folder "Account DB" as AccountDB
  folder "Business DB" as BusinessDB
  folder "User Storage" as UserStorage
  folder "Auth Realm" as AuthRealm
}

' --- Connections ---
ConfigServer --> DiscoveryService : provides config
ConfigServer --> GatewayService : provides config
ConfigServer --> AuthService : provides config
ConfigServer --> AccountService : provides config
ConfigServer --> BusinessService : provides config

DiscoveryService --> GatewayService : registers
DiscoveryService --> AuthService : registers
DiscoveryService --> AccountService : registers
DiscoveryService --> BusinessService : registers

GatewayService --> AuthService : routes /auth/**
GatewayService --> AccountService : routes /api/accounts/**
GatewayService --> BusinessService : routes /api/business/**

AuthService --> Keycloak : user management
AuthService --> AccountService : creates accounts


AccountService --> Postgres : AccountDB access
BusinessService --> Postgres : BusinessDB access
Keycloak --> Postgres : UserStorage access
Keycloak --> Postgres : AuthRealm access

' --- External Clients ---
actor "Web Client" as WebClient
actor "Mobile Client" as MobileClient
actor "Admin User" as AdminUser

WebClient --> GatewayService : API requests
MobileClient --> GatewayService : API requests
AdminUser --> Keycloak : admin console

' --- Security ---
AuthService --> GatewayService : validates JWT tokens
GatewayService --> AuthService : forwards auth requests

note right of GatewayService
  • JWT Validation
  • Rate Limiting
  • CORS Management
  • Load Balancing
end note

note right of AuthService
  • User Registration
  • Login/Logout
  • Token Refresh
  • Role Management
end note

note right of AccountService
  • CRUD Operations
  • Account Management
  • Data Validation
  • Search & Filter
end note

@enduml